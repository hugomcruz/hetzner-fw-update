# Hetzner Cloud API Token (required)
# Get from: https://console.hetzner.cloud/ → Security → API Tokens
HETZNER_API_TOKEN=your_hetzner_api_token_here

# Hetzner Firewall ID (required)
# Find in: https://console.hetzner.cloud/ → Firewalls → [Your Firewall]
HETZNER_FIREWALL_ID=your_firewall_id_here

# Ports to allow (optional, default: 80,443)
FIREWALL_PORTS=80,443

# Log level (optional, default: INFO)
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
